  },

  "complex_metrics_example": {
    "dialect": "snowflake",
    "schema": "ANALYTICS",
    "tables": [
      {
        "name": "orders",
        "columns": [
          {"name": "order_id", "type": "INTEGER"},
          {"name": "customer_id", "type": "INTEGER"},
          {"name": "warehouse_id", "type": "INTEGER"},
          {"name": "order_date", "type": "DATE"}
        ]
      },
      {
        "name": "order_lines",
        "columns": [
          {"name": "order_id", "type": "INTEGER"},
          {"name": "quantity", "type": "INTEGER"},
          {"name": "unit_price", "type": "DECIMAL"},
          {"name": "discount_pct", "type": "DECIMAL"}
        ]
      },
      {
        "name": "returns",
        "columns": [
          {"name": "order_id", "type": "INTEGER"},
          {"name": "refund_amount", "type": "DECIMAL"}
        ]
      },
      {
        "name": "warehouses",
        "columns": [
          {"name": "warehouse_id", "type": "INTEGER"},
          {"name": "region", "type": "VARCHAR"}
        ]
      }
    ],
    "constraints": {
      "time_range": "last_90_days",
      "join_hints": [
        "orders.order_id -> order_lines.order_id",
        "orders.order_id -> returns.order_id",
        "orders.warehouse_id -> warehouses.warehouse_id"
      ],
      "metric_definitions": {
        "net_revenue": "SUM(ol.quantity * ol.unit_price * (1 - ol.discount_pct)) - COALESCE(SUM(r.refund_amount), 0)"
      }
    },
    "question": "Calculate net revenue by region for the last 90 days, accounting for discounts and returns"
  }
}
