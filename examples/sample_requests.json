  "postgres_example": {
    "dialect": "postgres",
    "schema": "public",
    "tables": [
      {
        "name": "products",
        "description": "Product catalog",
        "columns": [
          {"name": "product_id", "type": "INTEGER", "description": "Product ID"},
          {"name": "product_name", "type": "VARCHAR", "description": "Product name"},
          {"name": "category", "type": "VARCHAR", "description": "Product category"},
          {"name": "price", "type": "NUMERIC", "description": "Product price"}
        ]
      },
      {
        "name": "sales",
        "description": "Sales transactions",
        "columns": [
          {"name": "sale_id", "type": "INTEGER", "description": "Sale ID"},
          {"name": "product_id", "type": "INTEGER", "description": "Product ID"},
          {"name": "quantity", "type": "INTEGER", "description": "Quantity sold"},
          {"name": "sale_date", "type": "DATE", "description": "Sale date"}
        ]
      }
    ],
    "constraints": {
      "join_hints": ["sales.product_id -> products.product_id"],
      "time_range": "2025-01-01..2025-12-31"
    },
    "question": "Which product categories generated the most revenue in 2025?"
  },

  "mysql_example": {
