{
  "snowflake_example": {
    "dialect": "snowflake",
    "catalog": "PROD_DB",
    "schema": "ANALYTICS",
    "tables": [
      {
        "name": "orders",
        "description": "Customer orders table",
        "columns": [
          {"name": "order_id", "type": "INTEGER", "description": "Unique order ID"},
          {"name": "customer_id", "type": "INTEGER", "description": "Customer ID"},
          {"name": "order_date", "type": "DATE", "description": "Date order was placed"},
          {"name": "order_status", "type": "VARCHAR", "description": "Order status"},
          {"name": "total_amount", "type": "DECIMAL", "description": "Total order amount"}
        ],
        "rowcount_estimate": 1000000
      },
      {
        "name": "customers",
        "description": "Customer information",
        "columns": [
          {"name": "customer_id", "type": "INTEGER", "description": "Unique customer ID"},
          {"name": "customer_name", "type": "VARCHAR", "description": "Customer name"},
          {"name": "region", "type": "VARCHAR", "description": "Geographic region"}
        ],
        "rowcount_estimate": 50000
      }
    ],
    "constraints": {
      "time_range": "last_90_days",
      "filters": ["order_status IN ('shipped', 'delivered')"],
      "join_hints": ["orders.customer_id -> customers.customer_id"]
    },
    "question": "Show the top 10 customers by total order amount in the last 90 days"
  },

